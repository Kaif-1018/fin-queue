# Copy to .env and fill in. .env is gitignored; this file is not.
#
# docker compose interpolates a root .env automatically, so JWT_SECRET_KEY set
# here reaches both the backend and the worker without further wiring.

# ── Auth ──────────────────────────────────────────────────────────
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# config.py refuses to start if this is left at the in-repo placeholder while
# DEBUG=False, so a production deploy cannot silently issue forgeable tokens.
JWT_SECRET_KEY=

# HS256 is symmetric — the same secret signs and verifies. Switch to RS256 only
# if a separate service needs to verify tokens without being able to mint them.
JWT_ALGORITHM=HS256

# Kept short because the WebSocket carries this token in its query string, where
# it lands in access logs and browser history.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────
# The async (asyncpg) URL. tasks.py derives the sync psycopg2 URL from it by
# string replacement, so only this one needs setting.
DATABASE_URL=postgresql+asyncpg://jobplatform:jobplatform_secret@postgres:5432/jobplatform_db

# ── Redis ─────────────────────────────────────────────────────────
# db 0 is the Celery broker and the pub/sub channel; db 1 is the result backend.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── App ───────────────────────────────────────────────────────────
DEBUG=true

# ── Logging ───────────────────────────────────────────────────────
# console = colourised for humans, json = machine-parseable for log shipping.
LOG_FORMAT=console
LOG_LEVEL=INFO

# Logs every SQL statement *including bound parameters*, and cannot be quietened
# by log level once on. Leave false anywhere with real data.
SQL_ECHO=false
